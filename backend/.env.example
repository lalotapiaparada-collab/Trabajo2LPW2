# Configuración de base de datos SQL Server
ConnectionStrings__miconexion=Server=(localdb)\\MSSQLLocalDB;Initial Catalog=ReservasCanchasDB;Integrated Security=True;Encrypt=False

# Configuración JWT
Jwt__Key=reemplazar_por_clave_secreta_de_al_menos_32_caracteres
Jwt__Issuer=CanchasApi
Jwt__Audience=CanchasApiUsuarios
Jwt__ExpiraMinutos=30

# CORS - Origen permitido para el frontend de desarrollo
Cors__AllowedOrigins__0=https://localhost:5173

# Contraseña inicial para el seeder de desarrollo
Seed__AdminPassword=reemplazar_por_password_seguro_para_seeder
